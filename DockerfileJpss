FROM maven:3-amazoncorretto-27-alpine AS build

WORKDIR /app

COPY pom.xml /tmp/pom.xml
RUN mvn -f /tmp/pom.xml install -N

COPY ./jpss-resource/pom.xml ./pom.xml
RUN mvn dependency:go-offline

COPY ./jpss-resource/src ./src

RUN mvn clean package -DskipTests

FROM amazoncorretto:27-alpine

# CVE-2026-114938 (Java4Shell) is fixed in Corretto 27.0.1.1.4, but the Docker
# Hub image still ships 27.0.1.0.11. The image already trusts Corretto's apk
# repo, so take the fixed package from there. The version floor fails the build
# rather than ship an unpatched JVM, and is a no-op once the base catches up.
RUN apk add --no-cache --upgrade 'amazon-corretto-27>=27.0.1.1.4-r0'

RUN addgroup -S bonk-docker && adduser -S -G bonk-docker veto

WORKDIR /app

COPY --from=build /app/target/*.jar /app/runner.jar

RUN chown -R veto:bonk-docker /app

EXPOSE 7087

USER veto

# Sticker uploads are decoded and re-encoded with ImageIO, which lives in
# java.desktop. Headless is what Spring Boot sets anyway; stating it here keeps
# the requirement visible if this image ever gets a slimmer base.
ENTRYPOINT ["java", "-Djava.awt.headless=true", "-jar", "/app/runner.jar"]
